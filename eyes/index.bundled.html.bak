"<!DOCTYPE html>\n<html><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<script src=\"8550d70a-9131-41c6-8684-92361c2352cd\"><\u002Fscript>\n<\u002Fhead>\n<body>\n\n<x-dc>\n<helmet>\n<style>\n  html, body { margin: 0; padding: 0; height: 100%; background: #0b0c0e; overflow: hidden; }\n  a { color: rgb(226, 235, 244); } a:hover { color: rgb(160, 176, 192); }\n<\u002Fstyle>\n<\u002Fhelmet>\n<div style=\"position: relative; width: 100%; height: 100dvh; min-height: 100%; background: #0b0c0e; overflow: hidden;\">\n  <div data-stage=\"1\" style=\"position: absolute; inset: 0; will-change: transform;\">\n  <canvas data-sketch=\"1\" ref=\"{{ canvasRef }}\" style=\"position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none;\"><\u002Fcanvas>\n  <canvas data-fx=\"1\" style=\"position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none;\"><\u002Fcanvas>\n  <div title=\"{{ hitTitle }}\" sc-camel-on-click=\"{{ onFigure }}\" style=\"{{ hitStyle }}\"><\u002Fdiv>\n  <sc-for list=\"{{ eyes }}\" as=\"eye\" hint-placeholder-count=\"0\">\n    <div data-eye-socket=\"1\" style=\"{{ eye.socketStyle }}\">\n      <div data-eye-glow=\"1\" style=\"{{ eye.glowStyle }}\"><\u002Fdiv>\n      <div data-eye-iris=\"1\" style=\"{{ eye.irisStyle }}\"><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-for>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;mode&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;night&quot;,&quot;paper&quot;],&quot;default&quot;:&quot;night&quot;,&quot;tsType&quot;:&quot;\\&quot;night\\&quot; | \\&quot;paper\\&quot;&quot;,&quot;section&quot;:&quot;Drawing&quot;},&quot;seed&quot;:{&quot;editor&quot;:&quot;int&quot;,&quot;default&quot;:4211,&quot;min&quot;:1,&quot;max&quot;:99999,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Drawing&quot;},&quot;inkStrength&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:1,&quot;min&quot;:0.5,&quot;max&quot;:1.6,&quot;step&quot;:0.05,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Drawing&quot;},&quot;glow&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:1,&quot;min&quot;:0,&quot;max&quot;:2,&quot;step&quot;:0.1,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Paper&quot;},&quot;skyDensity&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:1,&quot;min&quot;:0.3,&quot;max&quot;:2,&quot;step&quot;:0.1,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Drawing&quot;},&quot;grain&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:1,&quot;min&quot;:0,&quot;max&quot;:2,&quot;step&quot;:0.1,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Paper&quot;}}\">\nclass Component extends DCLogic {\n  canvasRef = React.createRef();\n  state = { eyes: [], figBox: null, phase: 0 };\n\n  renderVals() {\n    const eyes = (this.state.eyes || []).map((e) => {\n      const d = e.r * 2;\n      return {\n        socketStyle: {\n          position: \"absolute\",\n          left: e.x - e.r + \"px\",\n          top: e.y - e.r + \"px\",\n          width: d + \"px\",\n          height: d + \"px\",\n          pointerEvents: \"none\"\n        },\n        glowStyle: {\n          position: \"absolute\",\n          left: \"50%\",\n          top: \"50%\",\n          width: d * 0.92 + \"px\",\n          height: d * 0.92 + \"px\",\n          transform: \"translate(-50%, -50%)\",\n          borderRadius: \"50%\",\n          background: \"radial-gradient(circle, #cfe8ff 0%, #7db4f5 22%, #3a6fb8 45%, rgba(32,74,140,0.42) 62%, rgba(24,56,110,0) 80%)\",\n          filter: \"blur(\" + (d * 0.086).toFixed(2) + \"px)\",\n        },\n        irisStyle: {\n          position: \"absolute\",\n          left: \"50%\",\n          top: \"50%\",\n          width: d * 0.52 + \"px\",\n          height: d * 0.52 + \"px\",\n          transform: \"translate(-50%, -50%)\",\n          borderRadius: \"50%\",\n          background: \"radial-gradient(circle, #ffffff 0%, #eaf6ff 30%, rgba(200,230,255,0.5) 55%, rgba(170,210,255,0) 75%)\",\n          filter: \"blur(\" + (d * 0.114).toFixed(2) + \"px)\",\n        }\n      };\n    });\n    const b = this.state.figBox;\n    const hitStyle = this.state.phase\n      ? { position: \"absolute\", inset: 0, cursor: \"pointer\", background: \"transparent\" }\n      : b\n        ? { position: \"absolute\", left: b.x + \"px\", top: b.y + \"px\", width: b.w + \"px\", height: b.h + \"px\", cursor: \"pointer\", background: \"transparent\" }\n        : { display: \"none\" };\n    return {\n      canvasRef: this.canvasRef,\n      eyes: eyes,\n      hitStyle: hitStyle,\n      hitTitle: this.state.phase ? \"back\" : \"look down\",\n      onFigure: () => (this.state.phase ? this.resetCalamity() : this.startCalamity())\n    };\n  }\n\n  componentDidMount() {\n    this._resize = () => {\n      clearTimeout(this._t);\n      this._t = setTimeout(() => this.paint(), 220);\n    };\n    window.addEventListener(\"resize\", this._resize);\n    if (window.ResizeObserver) {\n      this._ro = new ResizeObserver(this._resize);\n      const c = this.cv();\n      if (c && c.parentNode) this._ro.observe(c.parentNode);\n    }\n    this._move = (ev) => {\n      const p = ev.touches && ev.touches[0] ? ev.touches[0] : ev;\n      this.aimEyes(p.clientX / window.innerWidth, p.clientY / window.innerHeight);\n    };\n    window.addEventListener(\"mousemove\", this._move);\n    window.addEventListener(\"touchmove\", this._move, { passive: true });\n    this.paint();\n  }\n  componentDidUpdate(prevProps) {\n    const sig = JSON.stringify(this.props || {});\n    if (sig === this._sig) return;\n    this._sig = sig;\n    clearTimeout(this._t);\n    this._painted = false;\n    this._t = setTimeout(() => this.paint(), 60);\n  }\n  componentWillUnmount() {\n    window.removeEventListener(\"resize\", this._resize);\n    if (this._ro) this._ro.disconnect();\n    window.removeEventListener(\"mousemove\", this._move);\n    window.removeEventListener(\"touchmove\", this._move);\n    clearTimeout(this._t);\n  }\n\n  cv() {\n    return this.canvasRef.current || document.querySelector('canvas[data-sketch=\"1\"]');\n  }\n\n  /* ---------- randomness: seeded, gaussian-biased ---------- */\n  rngFrom(seed) {\n    let s = seed >>> 0;\n    return () => {\n      s = (s + 0x6d2b79f5) >>> 0;\n      let t = Math.imul(s ^ (s >>> 15), 1 | s);\n      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    };\n  }\n  r(a, b) { return a + this.R() * (b - a); }\n  g() { return (this.R() + this.R() + this.R() - 1.5) / 0.75; }   /* ~normal, |v| mostly < 1 */\n  hash1(i) { const x = Math.sin(i * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); }\n  n1(x, o) {\n    const xi = Math.floor(x), xf = x - xi;\n    const a = this.hash1(xi + o * 71.3), b = this.hash1(xi + 1 + o * 71.3);\n    const u = xf * xf * (3 - 2 * xf);\n    return a + (b - a) * u;\n  }\n\n  /* ---------- geometry helpers ---------- */\n  spline(pts, steps) {\n    if (pts.length < 3) return pts.slice();\n    const out = [], n = pts.length;\n    for (let i = 0; i < n - 1; i++) {\n      const p0 = pts[Math.max(0, i - 1)], p1 = pts[i], p2 = pts[i + 1], p3 = pts[Math.min(n - 1, i + 2)];\n      for (let j = 0; j < steps; j++) {\n        const t = j / steps, t2 = t * t, t3 = t2 * t;\n        out.push([\n          0.5 * (2 * p1[0] + (-p0[0] + p2[0]) * t + (2 * p0[0] - 5 * p1[0] + 4 * p2[0] - p3[0]) * t2 + (-p0[0] + 3 * p1[0] - 3 * p2[0] + p3[0]) * t3),\n          0.5 * (2 * p1[1] + (-p0[1] + p2[1]) * t + (2 * p0[1] - 5 * p1[1] + 4 * p2[1] - p3[1]) * t2 + (-p0[1] + 3 * p1[1] - 3 * p2[1] + p3[1]) * t3)\n        ]);\n      }\n    }\n    out.push(pts[n - 1].slice(0, 2));\n    return out;\n  }\n  densify(pts, sp) {\n    const out = [[pts[0][0], pts[0][1]]];\n    let cur = [pts[0][0], pts[0][1]], i = 1, rem = sp;\n    let guard = 0;\n    while (i < pts.length && guard++ < 20000) {\n      const b = pts[i], dx = b[0] - cur[0], dy = b[1] - cur[1], d = Math.hypot(dx, dy);\n      if (d < 1e-6) { i++; continue; }\n      if (d < rem) { rem -= d; cur = [b[0], b[1]]; i++; }\n      else { const t = rem / d; cur = [cur[0] + dx * t, cur[1] + dy * t]; out.push([cur[0], cur[1]]); rem = sp; }\n    }\n    const l = pts[pts.length - 1];\n    out.push([l[0], l[1]]);\n    return out;\n  }\n  pathLen(P) { let s = 0; for (let i = 1; i < P.length; i++) s += Math.hypot(P[i][0] - P[i - 1][0], P[i][1] - P[i - 1][1]); return s; }\n  pt(P, t) {\n    const n = P.length, f = Math.max(0, Math.min(n - 1.001, t * (n - 1)));\n    const i = Math.floor(f), fr = f - i, a = P[i], b = P[Math.min(n - 1, i + 1)];\n    let nx = -(b[1] - a[1]), ny = b[0] - a[0];\n    const l = Math.hypot(nx, ny) || 1;\n    return { x: a[0] + (b[0] - a[0]) * fr, y: a[1] + (b[1] - a[1]) * fr, nx: nx / l, ny: ny / l };\n  }\n\n  /* ---------- the pencil ---------- */\n  stroke(pts, o) {\n    o = o || {};\n    const ctx = this.ctx, u = this.u;\n    const alpha = (o.alpha == null ? 0.6 : o.alpha) * this.ink;\n    const width = o.width == null ? 1 : o.width;\n    const wobble = o.wobble == null ? 1 : o.wobble;\n    const passes = o.passes == null ? 1 : o.passes;\n    const taper = o.taper == null ? 1 : o.taper;\n    const grain = o.grain == null ? 0.5 : o.grain;\n    const breakUp = o.breakUp == null ? 0.3 : o.breakUp;\n    if (pts.length < 2 || alpha < 0.006) return;\n    const P = this.densify(pts, Math.max(1.6, 2.4 * u));\n    if (P.length < 2) return;\n    const total = Math.max(1, this.pathLen(P));\n    ctx.lineCap = \"round\";\n    ctx.lineJoin = \"round\";\n\n    for (let pass = 0; pass < passes; pass++) {\n      const ph = Math.floor(this.R() * 900);\n      const ph2 = Math.floor(this.R() * 900);\n      const lateral = pass === 0 ? 0 : this.g() * 1.15 * u * width;\n      const amp = wobble * u;\n      const D = [];\n      let acc = 0;\n      for (let i = 0; i < P.length; i++) {\n        const p = P[i];\n        if (i > 0) acc += Math.hypot(p[0] - P[i - 1][0], p[1] - P[i - 1][1]);\n        const t = acc / total;\n        const a = P[Math.max(0, i - 1)], b = P[Math.min(P.length - 1, i + 1)];\n        let nx = -(b[1] - a[1]), ny = b[0] - a[0];\n        const l = Math.hypot(nx, ny) || 1; nx /= l; ny /= l;\n        const w = (this.n1(t * 3.1 + ph, 7) - 0.5) * 2 * amp\n                + (this.n1(t * 8.7 + ph, 13) - 0.5) * amp * 0.4 + lateral;\n        D.push([p[0] + nx * w, p[1] + ny * w, t]);\n      }\n      const passA = pass === 0 ? 1 : 0.62;\n      for (let i = 1; i < D.length; i++) {\n        const A = D[i - 1], B = D[i], t = B[2];\n        let e = Math.min(1, t / 0.11) * Math.min(1, (1 - t) / 0.10);\n        e = 1 - taper * (1 - Math.pow(e, 0.62));\n        const press = 0.58 + 0.42 * this.n1(t * 5.5 + ph2, 21);\n        const lift = this.n1(t * 13 + ph2, 33) < breakUp * 0.42 ? 0.22 : 1;\n        const a = alpha * e * press * lift * passA;\n        if (a < 0.005) continue;\n        ctx.strokeStyle = \"rgba(\" + this.inkRGB + \",\" + Math.min(1, a) + \")\";\n        ctx.lineWidth = Math.max(0.35, width * u * (0.8 + 0.4 * this.n1(t * 6.3 + ph, 41)));\n        ctx.beginPath();\n        ctx.moveTo(A[0], A[1]);\n        ctx.lineTo(B[0], B[1]);\n        ctx.stroke();\n      }\n      if (grain > 0) {\n        const count = Math.floor((total / Math.max(2, 3 * u)) * grain);\n        for (let k = 0; k < count; k++) {\n          const idx = 1 + Math.floor(this.R() * (D.length - 1));\n          const A = D[idx - 1], B = D[idx];\n          let nx = -(B[1] - A[1]), ny = B[0] - A[0];\n          const l = Math.hypot(nx, ny) || 1; nx /= l; ny /= l;\n          const off = this.g() * (0.55 + width * 0.75) * u;\n          let e = Math.min(1, B[2] / 0.11) * Math.min(1, (1 - B[2]) / 0.10);\n          const a = alpha * (0.18 + 0.42 * this.R()) * (1 - taper * (1 - e));\n          if (a < 0.006) continue;\n          ctx.fillStyle = \"rgba(\" + this.inkRGB + \",\" + Math.min(1, a) + \")\";\n          ctx.beginPath();\n          ctx.arc(B[0] + nx * off, B[1] + ny * off, Math.max(0.28, u * this.r(0.22, 0.5)), 0, 6.2832);\n          ctx.fill();\n        }\n      }\n    }\n  }\n\n  /* a single hand gesture between two points: overshoot, bow, wobble */\n  gLine(a, b, o) {\n    o = o || {};\n    const dx = b[0] - a[0], dy = b[1] - a[1], L = Math.hypot(dx, dy) || 1;\n    const ux = dx / L, uy = dy / L, nx = -uy, ny = ux;\n    const ov = o.over == null ? 1 : o.over;\n    const o1 = ov * this.u * Math.abs(this.g()) * 3.2;\n    const o2 = ov * this.u * Math.abs(this.g()) * 3.2;\n    const A = [a[0] - ux * o1, a[1] - uy * o1];\n    const B = [b[0] + ux * o2, b[1] + uy * o2];\n    const bowAmt = (o.bow == null ? 1 : o.bow) * this.g() * Math.min(L * 0.045, 5 * this.u);\n    const M = [(A[0] + B[0]) / 2 + nx * bowAmt, (A[1] + B[1]) / 2 + ny * bowAmt];\n    this.stroke(this.spline([A, M, B], 9), o);\n  }\n\n  blocked(x, y) {\n    for (const c of this.clear) {\n      if ((x - c.x) * (x - c.x) + (y - c.y) * (y - c.y) < c.r * c.r) return true;\n    }\n    return false;\n  }\n\n  hatchAlong(path, o) {\n    const P = this.densify(path, Math.max(2, 3 * this.u));\n    const band = o.band, count = o.count;\n    for (let i = 0; i < count; i++) {\n      const t = this.r(o.t0 == null ? 0 : o.t0, o.t1 == null ? 1 : o.t1);\n      const p = this.pt(P, t);\n      const d = Math.pow(this.R(), o.bias == null ? 1.7 : o.bias) * band;\n      const side = o.side == null ? 1 : o.side;\n      const x = p.x + p.nx * side * d + this.g() * 2.2 * this.u;\n      const y = p.y + p.ny * side * d + this.g() * 2.2 * this.u;\n      if (this.blocked(x, y)) continue;\n      const ang = (typeof o.angle === \"function\" ? o.angle(x, y) : o.angle) + this.g() * (o.spray == null ? 0.11 : o.spray);\n      const L = o.len * this.r(0.45, 1.25);\n      const fade = 1 - (o.fade == null ? 0.7 : o.fade) * (d / band);\n      this.stroke([[x, y], [x + Math.cos(ang) * L, y + Math.sin(ang) * L]], {\n        alpha: o.alpha * fade * this.r(0.55, 1.25) * this.hatchInk,\n        width: (o.width || 1) * this.r(0.7, 1.5),\n        wobble: 0.45, taper: 0.85, grain: 0.18, breakUp: 0.3\n      });\n    }\n  }\n\n  hatchBox(x0, y0, x1, y1, o) {\n    for (let i = 0; i < o.count; i++) {\n      const x = this.r(x0, x1), y = this.r(y0, y1);\n      if (this.blocked(x, y)) continue;\n      const ang = o.angle + this.g() * 0.14;\n      const L = o.len * this.r(0.4, 1.3);\n      this.stroke([[x, y], [x + Math.cos(ang) * L, y + Math.sin(ang) * L]], {\n        alpha: o.alpha * this.r(0.4, 1.2) * this.hatchInk, width: (o.width || 0.85) * this.r(0.6, 1.4),\n        wobble: 0.5, taper: 0.9, grain: 0.16, breakUp: 0.32\n      });\n    }\n  }\n\n  fillPoly(poly, alpha) {\n    const ctx = this.ctx;\n    ctx.save();\n    ctx.globalAlpha = alpha;\n    ctx.globalCompositeOperation = \"destination-out\";\n    ctx.fillStyle = \"#000\";\n    ctx.beginPath();\n    ctx.moveTo(poly[0][0], poly[0][1]);\n    for (let i = 1; i < poly.length; i++) ctx.lineTo(poly[i][0], poly[i][1]);\n    ctx.closePath();\n    ctx.fill();\n    ctx.restore();\n  }\n\n  /* ---------- scene parts ---------- */\n  background() {\n    const ctx = this.vctx, W = this.W, H = this.H;\n    ctx.fillStyle = this.paper;\n    ctx.fillRect(0, 0, W, H);\n    for (let i = 0; i < 7; i++) {\n      const gx = this.r(0, W), gy = this.r(0, H), rr = this.r(0.25, 0.7) * Math.max(W, H);\n      const gr = ctx.createRadialGradient(gx, gy, 0, gx, gy, rr);\n      const alt = this.R() > 0.5;\n      if (this.night) {\n        gr.addColorStop(0, alt ? \"rgba(96,116,146,0.1)\" : \"rgba(44,48,58,0.18)\");\n        gr.addColorStop(1, \"rgba(0,0,0,0)\");\n      } else {\n        gr.addColorStop(0, alt ? \"rgba(214,206,188,0.16)\" : \"rgba(255,255,255,0.2)\");\n        gr.addColorStop(1, \"rgba(255,255,255,0)\");\n      }\n      ctx.fillStyle = gr;\n      ctx.fillRect(0, 0, W, H);\n    }\n  }\n\n  skyFlow(x, y) {\n    let vx = 0.85, vy = 0.46 * Math.sin(x * 0.0042 + y * 0.0062) + 0.26 * Math.sin(y * 0.0095 + 1.7);\n    for (const v of this.vort) {\n      const dx = x - v.x, dy = (y - v.y) * 1.7;\n      const d2 = dx * dx + dy * dy, d = Math.sqrt(d2) + 1;\n      const core = 0.34 * v.r;\n      const f = v.s * Math.exp(-d2 / (2 * v.r * v.r)) * (1 - Math.exp(-d2 / (2 * core * core)));\n      vx += (-dy / d) * f * v.r * 0.115;\n      vy += (dx / d) * f * v.r * 0.115;\n    }\n    const sb = this.skyBottom;\n    vy += 0.55 * Math.exp(-Math.max(0, y) / (0.13 * sb));\n    vy -= 0.55 * Math.exp(-Math.max(0, sb - y) / (0.13 * sb));\n    const l = Math.hypot(vx, vy) || 1;\n    return [vx / l, vy / l];\n  }\n\n  streamline(x, y, len) {\n    const step = 3.2 * this.u, pts = [];\n    const top = -0.03 * this.H, bot = this.skyBottom * 1.03;\n    let n = Math.floor(len / step);\n    for (let i = 0; i < n; i++) {\n      pts.push([x, y]);\n      const v = this.skyFlow(x, y);\n      x += v[0] * step; y += v[1] * step;\n      if (y < top || y > bot || x < -0.06 * this.W || x > 1.06 * this.W) break;\n    }\n    return pts;\n  }\n\n  sky() {\n    const W = this.W, H = this.H, sb = this.skyBottom;\n    const cell = Math.max(4, Math.min(W, H) * 0.014);\n    this.skyGrid = { c: cell, w: Math.ceil(W / cell) + 2, h: Math.ceil(sb / cell) + 2, a: null };\n    this.skyGrid.a = new Uint8Array(this.skyGrid.w * this.skyGrid.h);\n    this.vort = [];\n    const nv = Math.max(5, Math.round(7 * Math.sqrt((W * sb) / (480 * 440))) + Math.floor(this.R() * 3));\n    for (let i = 0; i < nv; i++) {\n      this.vort.push({\n        x: (-0.06 + 1.12 * ((i + this.R()) / nv)) * W,\n        y: this.r(0.04, 0.94) * sb,\n        r: this.r(0.09, 0.306) * sb,\n        s: (this.R() > 0.5 ? 1 : -1) * this.r(0.9, 1.75)\n      });\n    }\n    const dens = this.props.skyDensity == null ? 1 : this.props.skyDensity;\n    const n = Math.max(8, Math.round(64 * dens * Math.sqrt((W * sb) / (480 * 440))));\n    const minD = Math.min(W, H);\n    for (let i = 0; i < n; i++) {\n      const sx = (-0.05 + 1.1 * ((i % n + this.R()) / n)) * W;\n      const sy = this.R() * sb * 0.96;\n      const len = minD * this.r(0.35, 2.1);\n      const line = this.streamline(sx, sy, len);\n      if (line.length < 8) continue;\n      this.markSky(line);\n      const depth = 1 - sy / sb;\n      const base = 0.3 + 0.34 * depth;\n      this.stroke(line, { alpha: base + this.r(0, 0.16), width: this.r(0.7, 1.05), wobble: 0.5, taper: 1, grain: 0.4, breakUp: 0.3 });\n      if (this.R() < 0.58) {\n        const off = this.r(4, 17) * this.u * (this.R() > 0.5 ? 1 : -1);\n        const trim = Math.floor(line.length * this.r(0.05, 0.22));\n        const par = [];\n        for (let k = trim; k < line.length - Math.floor(trim * 0.7); k++) {\n          const a = line[Math.max(0, k - 1)], b = line[Math.min(line.length - 1, k + 1)];\n          let nx = -(b[1] - a[1]), ny = b[0] - a[0];\n          const l = Math.hypot(nx, ny) || 1;\n          par.push([line[k][0] + (nx / l) * off, line[k][1] + (ny / l) * off]);\n        }\n        if (par.length > 6) this.stroke(par, { alpha: base * 0.85, width: this.r(0.65, 0.95), wobble: 0.55, taper: 1, grain: 0.35, breakUp: 0.34 });\n      }\n    }\n    const ne = 1 + Math.floor(this.R() * 2);\n    for (let i = 0; i < ne; i++) {\n      const rad = minD * this.r(0.022, 0.048);\n      let ex = 0, ey = 0, best = 1e9;\n      for (let tries = 0; tries < 90; tries++) {\n        const px = this.r(0.12, 0.9) * W, py = this.r(0.12, 0.85) * sb;\n        const score = this.skyLoad(px, py, rad * 2.1);\n        if (score < best) { best = score; ex = px; ey = py; }\n        if (best === 0) break;\n      }\n      this.eddy(ex, ey, rad, this.r(-0.6, 0.6));\n      const ring = [];\n      for (let k = 0; k <= 16; k++) {\n        const aa = 6.283 * (k / 16);\n        ring.push([ex + Math.cos(aa) * rad * 1.15, ey + Math.sin(aa) * rad * 1.15]);\n      }\n      this.markSky(ring);\n      this.markSky([[ex, ey]]);\n    }\n    this.moonAndStars();\n  }\n\n  markSky(pts) {\n    const g = this.skyGrid;\n    if (!g) return;\n    for (const p of pts) {\n      const cx = Math.round(p[0] / g.c), cy = Math.round(p[1] / g.c);\n      for (let dy = -1; dy <= 1; dy++) {\n        for (let dx = -1; dx <= 1; dx++) {\n          const x = cx + dx, y = cy + dy;\n          if (x >= 0 && y >= 0 && x < g.w && y < g.h) g.a[y * g.w + x] = 1;\n        }\n      }\n    }\n  }\n\n  skyLoad(x, y, rad) {\n    const g = this.skyGrid;\n    if (!g) return 0;\n    const r = Math.ceil(rad / g.c);\n    const cx = Math.round(x / g.c), cy = Math.round(y / g.c);\n    let n = 0;\n    for (let dy = -r; dy <= r; dy++) {\n      for (let dx = -r; dx <= r; dx++) {\n        const px = cx + dx, py = cy + dy;\n        if (px < 0 || py < 0 || px >= g.w || py >= g.h) { n++; continue; }\n        if (g.a[py * g.w + px]) n++;\n      }\n    }\n    return n;\n  }\n\n  skyFree(x, y, rad) {\n    const g = this.skyGrid;\n    if (!g) return true;\n    const r = Math.ceil(rad / g.c);\n    const cx = Math.round(x / g.c), cy = Math.round(y / g.c);\n    for (let dy = -r; dy <= r; dy++) {\n      for (let dx = -r; dx <= r; dx++) {\n        const px = cx + dx, py = cy + dy;\n        if (px < 0 || py < 0 || px >= g.w || py >= g.h) continue;\n        if (g.a[py * g.w + px]) return false;\n      }\n    }\n    return true;\n  }\n\n  moonAndStars() {\n    const W = this.W, sb = this.skyBottom, minD = Math.min(W, this.H);\n    /* moon: one open disc with a crescent shadow arc, in clear sky */\n    const mr = minD * this.r(0.045, 0.062);\n    let mx = 0, my = 0, best = 1e9;\n    for (let tries = 0; tries < 260; tries++) {\n      const cxx = this.r(0.03, 0.2) * W, cyy = this.r(0.05, 0.34) * sb;\n      const score = this.skyLoad(cxx, cyy, mr * 1.7);\n      if (score < best) { best = score; mx = cxx; my = cyy; }\n      if (best === 0) break;\n    }\n    {\n      const halo = [];\n      for (let i = 0; i <= 40; i++) {\n        const a = 6.283 * (i / 40);\n        halo.push([mx + Math.cos(a) * mr * 1.3, my + Math.sin(a) * mr * 1.3]);\n      }\n      this.fillPoly(halo, 1);\n      const disc = [];\n      const st = this.R() * 6.283;\n      for (let i = 0; i <= 60; i++) {\n        const a = st + 6.283 * (i / 60) * this.r(0.99, 1.02);\n        const rr = mr * (1 + 0.04 * (this.n1(i * 0.3, 3) - 0.5));\n        disc.push([mx + Math.cos(a) * rr, my + Math.sin(a) * rr]);\n      }\n      this.stroke(disc, { alpha: 0.6, width: 1.15, wobble: 0.25, taper: 0.3, grain: 0.45, breakUp: 0.2 });\n      const cres = [], a0 = this.r(-0.5, 0.5);\n      for (let i = 0; i <= 26; i++) {\n        const a = a0 + 1.15 + 3.4 * (i / 26);\n        cres.push([mx + Math.cos(a) * mr * 0.62 + mr * 0.3, my + Math.sin(a) * mr * 0.92]);\n      }\n      this.stroke(cres, { alpha: 0.34, width: 0.9, wobble: 0.3, taper: 0.6, grain: 0.35 });\n      /* everything below runs on its own stream so the scene layout stays put */\n      const mainR = this.R;\n      this.R = this.rngFrom(90210);\n      if (this.night) {\n        const g2 = this.ctx.createRadialGradient(mx, my, mr * 0.25, mx, my, mr * 3.1);\n        g2.addColorStop(0, \"rgba(\" + this.inkRGB + \",0.26)\");\n        g2.addColorStop(0.34, \"rgba(\" + this.inkRGB + \",0.12)\");\n        g2.addColorStop(0.62, \"rgba(\" + this.inkRGB + \",0.04)\");\n        g2.addColorStop(1, \"rgba(\" + this.inkRGB + \",0)\");\n        this.ctx.save();\n        this.ctx.fillStyle = g2;\n        this.ctx.fillRect(mx - mr * 3.1, my - mr * 3.1, mr * 6.2, mr * 6.2);\n        this.ctx.restore();\n      }\n      this.stroke(disc, { alpha: this.night ? 0.8 : 0.3, width: this.night ? 1.6 : 1.1, wobble: 0.22, taper: 0.25, grain: 0.5, breakUp: 0.12, passes: 2 });\n      const lb = [], la = this.r(-0.6, 0.6);\n      for (let i = 0; i <= 22; i++) {\n        const aa = la + 0.5 + 2.1 * (i / 22);\n        lb.push([mx + Math.cos(aa) * mr * 0.97, my + Math.sin(aa) * mr * 0.97]);\n      }\n      this.stroke(lb, { alpha: this.night ? 0.55 : 0.28, width: 1.5, wobble: 0.2, taper: 0.85, grain: 0.4 });\n      this.R = mainR;\n      this.markSky(disc);\n      for (let ring = 0; ring < 3; ring++) {\n        const rr2 = mr * (1.6 + ring * 0.7), pts = [];\n        for (let k = 0; k < 26; k++) {\n          const aa = 6.283 * (k / 26);\n          pts.push([mx + Math.cos(aa) * rr2, my + Math.sin(aa) * rr2]);\n        }\n        this.markSky(pts);\n      }\n    }\n    /* stars: own stream, so tweaking them never re-rolls the landscape */\n    const starR = this.R;\n    this.R = this.rngFrom(31337);\n    const n = Math.round(40 * Math.sqrt((W * sb) / (480 * 440)));\n    for (let i = 0; i < n; i++) {\n      let sxp = 0, syp = 0, ok = false;\n      for (let tries = 0; tries < 40 && !ok; tries++) {\n        sxp = this.r(0.01, 0.99) * W;\n        syp = this.r(0.02, 0.92) * sb;\n        if (this.skyLoad(sxp, syp, minD * 0.014) === 0) ok = true;\n      }\n      if (!ok) continue;\n      const a = this.r(0.45, 0.85);\n      const kind = this.R();\n      if (kind < 0.22) {\n        /* the doodled five-point star: one continuous stroke, small */\n        const rr = minD * this.r(0.008, 0.015);\n        const rot = -1.5708 + this.g() * 0.22;\n        const order = [0, 2, 4, 1, 3, 0];\n        const pts = order.map((k) => {\n          const aa = rot + k * 1.2566;\n          const rj = rr * this.r(0.9, 1.1);\n          return [sxp + Math.cos(aa) * rj, syp + Math.sin(aa) * rj];\n        });\n        pts.push([pts[1][0] + this.g() * rr * 0.12, pts[1][1] + this.g() * rr * 0.12]);\n        this.stroke(pts, { alpha: a * this.r(0.9, 1.15), width: this.r(1.1, 1.5), wobble: 0.22, taper: 0.35, grain: 0.45, breakUp: 0.14 });\n      } else if (kind < 0.62) {\n        const L = minD * this.r(0.008, 0.02);\n        const rot = this.r(0, 1.5);\n        this.stroke([[sxp - Math.cos(rot) * L, syp - Math.sin(rot) * L], [sxp + Math.cos(rot) * L, syp + Math.sin(rot) * L]], { alpha: a, width: 0.85, wobble: 0.15, taper: 1, grain: 0.2 });\n        this.stroke([[sxp - Math.cos(rot + 1.57) * L * 0.7, syp - Math.sin(rot + 1.57) * L * 0.7], [sxp + Math.cos(rot + 1.57) * L * 0.7, syp + Math.sin(rot + 1.57) * L * 0.7]], { alpha: a * 0.8, width: 0.8, wobble: 0.15, taper: 1, grain: 0.2 });\n      } else {\n        const L = minD * this.r(0.002, 0.005);\n        this.stroke([[sxp - L, syp], [sxp + L, syp]], { alpha: a * 0.9, width: 1.0, wobble: 0.1, taper: 0.4, grain: 0.2 });\n      }\n      this.markSky([[sxp, syp]]);\n    }\n    this.R = starR;\n  }\n\n  eddy(cx, cy, rad, rot) {\n    const n = 2 + Math.floor(this.R() * 3);\n    for (let k = 0; k < n; k++) {\n      const rr = rad * (1 - k * 0.27), sq = this.r(0.4, 0.72);\n      const start = this.R() * 6.283, turns = this.r(0.94, 1.1), steps = 46;\n      const pts = [];\n      for (let i = 0; i <= steps; i++) {\n        const a = start + turns * 6.283 * (i / steps);\n        const r2 = rr * (1 + 0.07 * (this.n1(i * 0.28 + k * 13, 5) - 0.5));\n        const ex = Math.cos(a) * r2, ey = Math.sin(a) * r2 * sq;\n        pts.push([cx + ex * Math.cos(rot) - ey * Math.sin(rot), cy + ex * Math.sin(rot) + ey * Math.cos(rot)]);\n      }\n      this.stroke(pts, { alpha: this.r(0.3, 0.48), width: this.r(0.7, 0.95), wobble: 0.32, taper: 0.5, grain: 0.35, breakUp: 0.26 });\n    }\n  }\n\n  distantRidge() {\n    const W = this.W, top = this.mesaTop;\n    for (let k = 0; k < 2; k++) {\n      const pts = [];\n      const n = 6 + Math.floor(this.R() * 4);\n      const baseY = top + (k === 0 ? -this.H * 0.035 : this.H * 0.01);\n      for (let i = 0; i <= n; i++) {\n        pts.push([-0.05 * W + (1.1 * W * i) / n, baseY + this.g() * this.H * 0.035 - this.H * 0.02 * Math.sin((i / n) * 3.1)]);\n      }\n      const sp = this.spline(pts, 12);\n      this.stroke(sp, { alpha: this.r(0.2, 0.34), width: this.r(0.85, 1.1), wobble: 0.7, taper: 1, grain: 0.3, breakUp: 0.3 });\n      if (this.R() < 0.7) this.stroke(sp, { alpha: 0.16, width: 0.8, wobble: 1.4, taper: 1, grain: 0.2, breakUp: 0.4 });\n    }\n  }\n\n  mesas() {\n    const W = this.W, top = this.mesaTop, base = this.horizon;\n    const bh = base - top;\n    this.mesaBH = bh;\n    const list = [];\n    let x = -0.12 * W;\n    let guard = 0;\n    while (x < W * 1.04 && guard++ < 80) {\n      const kind = this.R();\n      const bu = Math.min(W * 0.17, bh * 0.9);\n      let w, h;\n      if (kind < 0.14) { w = bu * this.r(1.1, 1.8); h = bh * this.r(0.3, 0.6); }\n      else if (kind < 0.4) { w = bu * this.r(0.3, 0.62); h = bh * this.r(0.16, 0.42); }\n      else { w = bu * this.r(0.5, 1.1); h = Math.min(bh * this.r(0.5, 1.15), w * this.r(0.9, 1.55)); }\n      const depth = this.R();\n      h *= 0.72 + 0.4 * depth;\n      let by = base + (depth - 0.8) * bh * 0.26;\n      h = Math.min(h, by - (top * 0.8 + this.H * 0.022));\n      if (h < bh * 0.4) by = Math.min(by, base - bh * this.r(0.02, 0.14));\n      list.push({ x: x, w: w, h: h, depth: depth, base: by });\n      x += w * this.r(0.35, 0.85) + (this.R() < 0.2 ? W * this.r(0.01, 0.05) : 0);\n    }\n    list.sort((a, b) => a.depth - b.depth);\n    for (const b of list) this.mesa(b, b.base);\n  }\n\n  mesa(b, base) {\n    const w = b.w, h = b.h, x = b.x, d = b.depth;\n    const y0 = base - h;\n    const tilt = this.g() * h * 0.07;\n    const prof = [[x, y0 + this.g() * h * 0.02]];\n    const nst = Math.floor(this.R() * 2.7);\n    let lastX = x, lastY = prof[0][1];\n    for (let s = 0; s < nst; s++) {\n      const tx = x + w * this.r(0.18, 0.86);\n      if (tx <= lastX + w * 0.08) continue;\n      prof.push([tx, lastY + tilt * ((tx - x) / w)]);\n      lastY = lastY + (this.R() < 0.5 ? -1 : 1) * h * this.r(0.05, 0.17);\n      prof.push([tx + this.g() * w * 0.02, lastY]);\n      lastX = tx;\n    }\n    prof.push([x + w, lastY + tilt * 0.5 + this.g() * h * 0.02]);\n    if (this.R() < 0.38) {\n      const pe = prof[prof.length - 1];\n      prof.splice(prof.length - 1, 0, [pe[0] - w * this.r(0.12, 0.34), pe[1]]);\n      pe[1] += h * this.r(0.07, 0.2);\n    }\n    if (this.R() < 0.32) {\n      const p0 = prof[0];\n      prof.splice(1, 0, [p0[0] + w * this.r(0.12, 0.34), p0[1]]);\n      p0[1] += h * this.r(0.07, 0.2);\n    }\n    const bot = base + this.H * 0.02;\n    this.fillPoly([[x, bot]].concat(prof, [[x + w, bot]]), 1);\n\n    const alpha = (0.52 + 0.48 * d) * (this.night ? 0.72 : 1);\n    const width = 1.0 + 0.95 * d;\n    const showTop = h > this.mesaBH * 0.34 ? this.R() < 0.8 : this.R() < 0.3;\n    if (showTop) {\n      const dir = this.R() < 0.35 ? (this.R() < 0.5 ? 1 : -1) : (x + w / 2 < this.W / 2 ? 1 : -1);\n      const tdx = dir * w * this.r(0.18, 0.42), tdy = -h * this.r(0.07, 0.19);\n      const back = prof.map((p) => [p[0] + tdx, p[1] + tdy]);\n      this.fillPoly(prof.concat(back.slice().reverse()), 1);\n      this.stroke(this.spline(back, 6), { alpha: alpha * 0.8, width: width * 0.85, wobble: 0.6, taper: 1, grain: 0.35, breakUp: 0.3 });\n      this.gLine(prof[0], back[0], { alpha: alpha * 0.8, width: width * 0.8, wobble: 0.5, grain: 0.3 });\n      this.gLine(prof[prof.length - 1], back[back.length - 1], { alpha: alpha * 0.85, width: width * 0.85, wobble: 0.5, grain: 0.3 });\n      const bk = dir > 0 ? back[back.length - 1] : back[0];\n      if (h > this.H * 0.05) this.gLine(bk, [bk[0], bk[1] + h * this.r(0.18, 0.45)], { alpha: alpha * 0.5, width: width * 0.7, wobble: 0.6, grain: 0.3, over: 0.5 });\n    }\n    for (let i = 1; i < prof.length; i++) {\n      this.gLine(prof[i - 1], prof[i], { alpha: alpha * this.r(0.85, 1.1), width: width, wobble: 0.55, taper: 0.8, grain: 0.45, passes: d > 0.6 && this.R() < 0.5 ? 2 : 1 });\n    }\n    const lean = this.g() * h * 0.05;\n    this.gLine(prof[0], [x + lean, base], { alpha: alpha, width: width, wobble: 0.6, taper: 0.7, grain: 0.45, over: 0.6, passes: d > 0.65 ? 2 : 1 });\n    this.gLine(prof[prof.length - 1], [x + w + lean * this.r(0.3, 1.1), base], { alpha: alpha, width: width, wobble: 0.6, taper: 0.7, grain: 0.45, over: 0.6, passes: d > 0.65 ? 2 : 1 });\n    if (this.R() < 0.55) {\n      const bx0 = x + w * this.r(0, 0.3), bx1 = x + w * this.r(0.7, 1);\n      this.gLine([bx0, base + this.g() * this.H * 0.004], [bx1, base + this.g() * this.H * 0.004], { alpha: alpha * 0.45, width: width * 0.7, wobble: 0.7, taper: 1, grain: 0.35 });\n    }\n    this.R(); this.R();\n  }\n\n  terraces() {\n    const W = this.W, H = this.H;\n    const y0 = this.horizon, y1 = this.cliffY;\n    const n = 3 + Math.floor(this.R() * 2);\n    for (let k = 0; k < n; k++) {\n      const yy = y0 + ((y1 - y0) * (k + 0.35)) / n;\n      const pts = [];\n      const m = 6 + Math.floor(this.R() * 5);\n      const slope = this.g() * (y1 - y0) * 0.42;\n      for (let i = 0; i <= m; i++) {\n        pts.push([-0.05 * W + (1.1 * W * i) / m, yy + slope * (i / m - 0.5) + this.g() * (y1 - y0) * 0.11]);\n      }\n      const sp = this.spline(pts, 10);\n      const a = 0.3 + 0.28 * (k / n);\n      let tc = this.r(-0.06, 0.03);\n      while (tc < 1) {\n        const seg = Math.min(1, tc + this.r(0.08, 0.32));\n        const piece = sp.slice(Math.max(0, Math.floor(tc * sp.length)), Math.floor(seg * sp.length));\n        if (piece.length > 4) this.stroke(piece, { alpha: a * this.r(0.75, 1.15), width: (0.85 + 0.5 * (k / n)) * this.r(0.85, 1.25), wobble: 1.0, taper: 1, grain: 0.45, breakUp: 0.3 });\n        tc = seg + this.r(0.03, 0.17);\n      }\n      const notches = 2 + Math.floor(this.R() * 4);\n      for (let i = 0; i < notches; i++) {\n        const t = this.R();\n        const p = this.pt(sp, t);\n        const dy = (y1 - y0) * this.r(0.06, 0.2);\n        this.gLine([p.x, p.y], [p.x + this.g() * W * 0.012, p.y + dy], { alpha: a * 0.8, width: 0.8, wobble: 0.7, taper: 0.8, grain: 0.35 });\n        if (this.R() < 0.6) {\n          this.gLine([p.x, p.y + dy], [p.x + W * this.r(0.02, 0.09), p.y + dy + this.g() * dy * 0.2], { alpha: a * 0.7, width: 0.8, wobble: 0.7, taper: 0.9, grain: 0.35 });\n        }\n      }\n      if (this.R() < 0.55) {\n        this.hatchAlong(sp, { side: 1, band: (y1 - y0) * 0.16, count: Math.round(W / (14 * this.u)) , angle: -0.32, len: H * 0.022, alpha: 0.14, width: 0.7, fade: 0.8 });\n      }\n    }\n  }\n\n  foreground() {\n    const W = this.W, H = this.H, cy = this.cliffY;\n    /* back ridge in the top-left of the foreground band */\n    const rb = this.spline([[-0.04 * W, cy - H * 0.075], [W * 0.12, cy - H * 0.09], [W * 0.26, cy - H * 0.062], [W * 0.4, cy - H * 0.075]], 12);\n    if (!this.night) this.stroke(rb, { alpha: 0.5, width: 1.05, wobble: 0.9, taper: 1, grain: 0.45, passes: 2 });\n    if (!this.night) this.hatchAlong(rb, { side: 1, band: H * 0.05, count: Math.round(70 * (W / 480)), angle: -0.3, len: H * 0.032, alpha: 0.42, width: 1.0, fade: 0.85, bias: 1.4 });\n\n    /* near plateau: far edge + crack */\n    const crackX = W * this.r(0.3, 0.4);\n    this.crackX = crackX;\n    const edge = this.spline([[-0.04 * W, cy - H * 0.03], [W * 0.1, cy - H * 0.016], [W * 0.2, cy - H * 0.006], [crackX * 0.9, cy - H * 0.004], [crackX, cy]], 12);\n    this.stroke(edge, { alpha: this.night ? 0.95 : 0.66, width: this.night ? 1.9 : 1.15, wobble: 0.8, taper: 1, grain: 0.5, passes: 2, breakUp: 0.22 });\n    const ne2 = 2 + Math.floor(this.R() * 3);\n    for (let i = 0; i < ne2; i++) {\n      const p = this.pt(edge, this.r(0.1, 0.9));\n      const dy = H * this.r(0.012, 0.03);\n      this.gLine([p.x, p.y], [p.x + this.g() * W * 0.01, p.y + dy], { alpha: 0.5, width: 1.0, wobble: 0.6, taper: 0.85, grain: 0.4 });\n      this.gLine([p.x, p.y + dy], [p.x - W * this.r(0.02, 0.08), p.y + dy + this.g() * dy * 0.3], { alpha: 0.46, width: 0.95, wobble: 0.7, taper: 0.9, grain: 0.4 });\n    }\n\n    const crack = this.spline([\n      [crackX, cy],\n      [crackX + W * this.r(-0.01, 0.03), cy + (H - cy) * 0.22],\n      [crackX - W * this.r(0.0, 0.04), cy + (H - cy) * 0.55],\n      [crackX - W * this.r(0.02, 0.09), H * 1.04]\n    ], 14);\n    this.stroke(crack, { alpha: this.night ? 1 : 0.9, width: this.night ? 2.4 : 1.6, wobble: 0.7, taper: 0.55, grain: 0.6, passes: 2, breakUp: 0.14 });\n\n    /* plateau surface: sparse angular facets */\n    const nf = 6 + Math.floor(this.R() * 5);\n    for (let i = 0; i < nf; i++) {\n      const sx = this.r(-0.02, 0.55) * crackX * 1.6;\n      const sy = this.r(cy + H * 0.01, H * 0.995);\n      let px = sx, py = sy;\n      const segs = 1 + Math.floor(this.R() * 3);\n      for (let s = 0; s < segs; s++) {\n        const ang = this.r(-0.5, 0.5) + (this.R() < 0.5 ? 0 : 2.6);\n        const L = Math.min(W, H) * this.r(0.05, 0.19);\n        const nxp = px + Math.cos(ang) * L, nyp = py + Math.sin(ang) * L * 0.7;\n        if (!this.night && nxp < crackX - W * 0.02) {\n          this.gLine([px, py], [nxp, nyp], { alpha: this.r(0.24, 0.45), width: this.r(0.7, 1.05), wobble: 0.7, taper: 0.9, grain: 0.4 });\n        }\n        px = nxp; py = nyp;\n      }\n    }\n    /* thin shading on the plateau lip, left of the crack */\n    this.hatchAlong(crack, { side: 1, band: W * 0.035, count: Math.round(120 * (W / 480)), angle: -0.62, len: Math.min(W, H) * 0.045, alpha: this.night ? 1.6 : 0.3, width: 0.9, fade: 0.9, bias: 2.1 });\n\n    /* --- the abyss --- */\n    const rings = [];\n    const minD = Math.min(W, H);\n    const rr0 = Math.min(W * 0.05, (H - cy) * 0.3);\n    const ax = W * (0.615 + this.g() * 0.015);\n    const ay = cy + (H - cy) * (0.22 + this.g() * 0.04);\n    for (let i = 0; i < 2; i++) {\n      const rr = rr0;\n      const cx = ax + i * W * 0.135;\n      const ccy = Math.min(ay, H - rr * 1.2);\n      rings.push({ x: cx, y: ccy, r: rr });\n      this.eyeSpots.push({ x: cx, y: ccy, r: rr });\n      this.clear.push({ x: cx, y: ccy, r: rr * 1.78 });\n    }\n\n    /* wall of the near side, right of the crack */\n    const wallAng = (x, y) => -1.18 + this.g() * 0.09;\n    this.hatchAlong(crack, { side: -1, band: W * 0.022, count: Math.round(120 * (W / 480)), bias: 1.2, t0: 0, t1: 0.5, angle: wallAng, len: minD * 0.04, alpha: 0.46, width: 1.6, fade: 0.3, spray: 0.1 });\n    this.hatchAlong(crack, { side: -1, band: W * 0.042, count: Math.round(180 * (W / 480)), bias: 1.2, t0: 0.32, t1: 0.85, angle: wallAng, len: minD * 0.055, alpha: 0.5, width: 1.7, fade: 0.28, spray: 0.1 });\n    this.hatchAlong(crack, { side: -1, band: W * 0.075, count: Math.round(200 * (W / 480)), bias: 1.15, t0: 0.65, t1: 1, angle: wallAng, len: minD * 0.07, alpha: 0.52, width: 1.8, fade: 0.26, spray: 0.12 });\n\n    /* undulating hatched bands receding into the depth */\n    this.hatchBox(crackX + W * 0.015, cy + (H - cy) * 0.04, W * 1.02, H * 1.0, {\n      angle: -0.34, count: Math.round(320 * (W / 480)), len: minD * 0.075, alpha: 0.12, width: 1.1\n    });\n    this.stroke(crack, { alpha: this.night ? 0.95 : 0.86, width: this.night ? 2.1 : 1.5, wobble: 0.5, taper: 0.5, grain: 0.4, breakUp: 0.12 });\n    if (this.night) this.stroke(crack, { alpha: 0.5, width: 0.9, wobble: 0.3, taper: 0.5, grain: 0.2, breakUp: 0.1 });\n    const nb = 5 + Math.floor(this.R() * 3);\n    const gap = (H - cy) / (nb - 0.4);\n    for (let k = 0; k < nb; k++) {\n      const y = cy + gap * (k * this.r(0.85, 1.15) + 0.2);\n      const startX = crackX + W * this.r(0.0, 0.09) - (k % 2) * W * 0.02;\n      const pts = [];\n      const m = 4 + Math.floor(this.R() * 4);\n      const amp = gap * this.r(0.5, 1.2);\n      for (let i = 0; i <= m; i++) {\n        const t = i / m;\n        pts.push([startX + (W * 1.06 - startX) * t, y + Math.sin(t * this.r(2.2, 5.4) + k) * amp + this.g() * amp * 0.4]);\n      }\n      const sp = this.spline(pts, 12);\n      this.stroke(sp, { alpha: this.r(0.4, 0.72) * this.deepInk, width: this.r(0.9, 1.5), wobble: 0.85, taper: 1, grain: 0.5, breakUp: 0.28, passes: this.R() < 0.4 ? 2 : 1 });\n      const dens = Math.round((this.pathLen(sp) / (2.4 * this.u)) * this.r(0.8, 1.2));\n      const steep = 0.55 + 0.25 * this.R();\n      this.hatchAlong(sp, {\n        side: 1, band: gap * this.r(0.8, 1.5), count: dens, bias: 1.5,\n        angle: (x) => -0.3 - steep * Math.max(0, (x - W * 0.66) / (W * 0.34)),\n        len: minD * this.r(0.055, 0.12), alpha: this.r(0.4, 0.6), width: 1.8, fade: 0.62, spray: 0.13\n      });\n      /* a darker clump somewhere along the band */\n      if (this.R() < 0.8) {\n        const t0 = this.r(0, 0.7);\n        this.hatchAlong(sp, {\n          side: 1, band: gap * this.r(0.4, 0.8), count: Math.round(dens * 0.75), bias: 1.2,\n          t0: t0, t1: Math.min(1, t0 + this.r(0.15, 0.4)),\n          angle: (x) => -0.3 - steep * Math.max(0, (x - W * 0.66) / (W * 0.34)),\n          len: minD * this.r(0.05, 0.1), alpha: 0.54, width: 1.95, fade: 0.35, spray: 0.11\n        });\n      }\n    }\n    this.hatchBox(W * this.r(0.42, 0.58), cy + (H - cy) * this.r(0.3, 0.48), W * 1.02, H, {\n      angle: -0.42, count: Math.round(300 * (W / 480)), len: minD * 0.075, alpha: 0.26, width: 1.8\n    });\n    this.hatchBox(W * 0.76, cy + (H - cy) * 0.2, W * 1.03, H, {\n      angle: -0.95, count: Math.round(170 * (W / 480)), len: minD * 0.06, alpha: 0.24, width: 1.7\n    });\n    this.hatchAlong(crack, { side: -1, band: W * 0.13, count: Math.round(150 * (W / 480)), bias: 1.6, t0: 0.72, t1: 1, angle: (x, y) => -0.5 + this.g() * 0.12, len: minD * 0.06, alpha: 0.3, width: 1.8, fade: 0.5, spray: 0.12 });\n    if (!this.night) for (const r of rings) this.ring(r.x, r.y, r.r);\n  }\n\n  ring(cx, cy, rad) {\n    const radii = [rad, rad * this.r(0.66, 0.76), rad * this.r(0.22, 0.3)];\n    for (let k = 0; k < radii.length; k++) {\n      const rr = radii[k], start = this.R() * 6.283, turns = this.r(0.98, 1.06), steps = 52;\n      const pts = [];\n      for (let i = 0; i <= steps; i++) {\n        const a = start + turns * 6.283 * (i / steps);\n        const r2 = rr * (1 + 0.035 * (this.n1(i * 0.3 + k * 17, 9) - 0.5));\n        pts.push([cx + Math.cos(a) * r2, cy + Math.sin(a) * r2]);\n      }\n      this.stroke(pts, { alpha: this.night ? 0.34 : 0.72, width: k === 2 ? 1.0 : 1.25, wobble: 0.28, taper: 0.35, grain: 0.5, breakUp: 0.2 });\n    }\n    const dr = rad * this.r(1.5, 1.7), nd = 22 + Math.floor(this.R() * 10);\n    let a = this.R() * 6.283;\n    for (let i = 0; i < nd; i++) {\n      const sweep = (6.283 / nd) * this.r(0.35, 0.7);\n      const pts = [];\n      for (let j = 0; j <= 5; j++) {\n        const aa = a + sweep * (j / 5);\n        const r2 = dr * (1 + 0.03 * (this.n1(i * 3 + j * 0.4, 11) - 0.5));\n        pts.push([cx + Math.cos(aa) * r2, cy + Math.sin(aa) * r2]);\n      }\n      this.stroke(pts, { alpha: this.r(0.35, 0.62) * (this.night ? 0.55 : 1), width: 0.9, wobble: 0.3, taper: 0.5, grain: 0.4 });\n      a += 6.283 / nd;\n    }\n  }\n\n  ellipseRing(c, along, across, rot, o) {\n    const pts = [], st = this.R() * 6.283, turns = this.r(0.97, 1.05);\n    for (let i = 0; i <= 40; i++) {\n      const a = st + 6.283 * turns * (i / 40);\n      const ex = Math.cos(a) * along, ey = Math.sin(a) * across;\n      pts.push([c[0] + ex * Math.cos(rot) - ey * Math.sin(rot), c[1] + ex * Math.sin(rot) + ey * Math.cos(rot)]);\n    }\n    this.stroke(pts, o);\n    return pts;\n  }\n\n  limb(a, b, r0, r1, rings, o) {\n    const dx = b[0] - a[0], dy = b[1] - a[1], L = Math.hypot(dx, dy) || 1;\n    const ux = dx / L, uy = dy / L, nx = -uy, ny = ux;\n    const at = (t, r, sgn) => [a[0] + dx * t + nx * r * sgn, a[1] + dy * t + ny * r * sgn];\n    const ang = Math.atan2(dy, dx);\n    this.fillPoly([at(-0.04, r0, 1), at(1.04, r1, 1), at(1.04, r1, -1), at(-0.04, r0, -1)], 1);\n    this.gLine(at(0, r0, 1), at(1, r1, 1), o);\n    this.gLine(at(0, r0, -1), at(1, r1, -1), o);\n    /* silhouette only: cap the ends so the limb reads as one closed shape */\n    if (o.cap !== false) {\n      this.ellipseRing(b, r1 * this.r(0.85, 1.0), r1 * 0.95, ang, { alpha: o.alpha * 0.5, width: o.width * 0.85, wobble: 0.3, taper: 0.6, grain: 0.35, breakUp: 0.3 });\n    }\n  }\n\n  joint(c, r, o) {\n    /* the body reads as one outline — joints only clear what is behind them */\n    this.fillPoly([[c[0] - r, c[1] - r], [c[0] + r, c[1] - r], [c[0] + r, c[1] + r], [c[0] - r, c[1] + r]], 1);\n    this.R();\n  }\n\n  /* the humanoid: a jointed mannequin at the rim, head bowed toward the eyes */\n  figure() {\n    const W = this.W, H = this.H;\n    const m = this.figMark || this.figSpot();\n    const hf = m.hf, fx = m.fx, fy = m.fy;\n    const ink = { alpha: this.night ? 1 : 0.85, width: this.night ? 2.3 : 1.3, wobble: 0.4, taper: 0.5, grain: 0.55, breakUp: 0.1, passes: this.night ? 2 : 1 };\n    const P = (dx, dy) => [fx + hf * dx, fy + hf * dy];\n\n    const hip = P(0.035, -0.47), chest = P(0.1, -0.76), neck = P(0.14, -0.83);\n    const headC = P(0.2, -0.885);\n    const kneeF = P(0.075, -0.235), ankleF = P(0.01, -0.03);\n    const kneeB = P(-0.075, -0.25), ankleB = P(-0.155, -0.025);\n    const shoulder = P(0.115, -0.775);\n    const elbowF = P(0.185, -0.62), handF = P(0.155, -0.47);\n    const elbowB = P(0.045, -0.63), handB = P(0.075, -0.48);\n\n    /* back limbs first so the near side overlaps them */\n    this.limb(hip, kneeB, hf * 0.064, hf * 0.052, 0, { ...ink, alpha: ink.alpha * 0.7, cap: false });\n    this.limb(kneeB, ankleB, hf * 0.052, hf * 0.036, 0, { ...ink, alpha: ink.alpha * 0.7, cap: false });\n    this.joint(kneeB, hf * 0.045, { ...ink, alpha: ink.alpha * 0.7 });\n    this.limb(shoulder, elbowB, hf * 0.047, hf * 0.037, 0, { ...ink, alpha: ink.alpha * 0.7, cap: false });\n    this.limb(elbowB, handB, hf * 0.037, hf * 0.028, 0, { ...ink, alpha: ink.alpha * 0.7 });\n\n    /* torso */\n    this.limb(hip, chest, hf * 0.105, hf * 0.092, 0, { ...ink, cap: false });\n    this.limb(neck, chest, hf * 0.045, hf * 0.06, 0, ink);\n    this.joint(hip, hf * 0.075, ink);\n\n    /* near leg + arm */\n    this.limb(hip, kneeF, hf * 0.068, hf * 0.055, 0, { ...ink, cap: false });\n    this.limb(kneeF, ankleF, hf * 0.055, hf * 0.038, 0, { ...ink, cap: false });\n    this.joint(kneeF, hf * 0.05, ink);\n    this.limb(shoulder, elbowF, hf * 0.05, hf * 0.04, 0, { ...ink, cap: false });\n    this.limb(elbowF, handF, hf * 0.04, hf * 0.03, 0, ink);\n    this.joint(elbowF, hf * 0.038, { ...ink, alpha: ink.alpha * 0.85 });\n\n    /* feet */\n    this.gLine(ankleF, [ankleF[0] + hf * 0.075, ankleF[1] + hf * 0.012], ink);\n    this.gLine([ankleF[0] + hf * 0.075, ankleF[1] + hf * 0.012], [ankleF[0] + hf * 0.01, ankleF[1] + hf * 0.028], { ...ink, alpha: ink.alpha * 0.8 });\n    this.gLine(ankleB, [ankleB[0] + hf * 0.062, ankleB[1] + hf * 0.014], { ...ink, alpha: ink.alpha * 0.7 });\n\n    /* head: bowed oval with meridian + equator contours */\n    const tilt = this.r(0.5, 0.72);\n    const rx = hf * 0.095, ry = hf * 0.12;\n    this.fillPoly([[headC[0] - rx * 1.35, headC[1] - ry * 1.35], [headC[0] + rx * 1.35, headC[1] - ry * 1.35], [headC[0] + rx * 1.35, headC[1] + ry * 1.35], [headC[0] - rx * 1.35, headC[1] + ry * 1.35]], 1);\n    this.ellipseRing(headC, rx, ry, tilt, { ...ink, alpha: ink.alpha, taper: 0.35, breakUp: 0.16 });\n    this.R(); this.R();\n    this.limb(neck, [headC[0] - Math.sin(tilt) * ry * 0.7, headC[1] + Math.cos(tilt) * ry * 0.7], hf * 0.04, hf * 0.036, 0, { ...ink, alpha: ink.alpha * 0.8, cap: false });\n  }\n\n  figSpot() {\n    const W = this.W, H = this.H, minD = Math.min(W, H);\n    return {\n      hf: Math.min(H * 0.3, Math.max(H * 0.21, minD * 0.28)),\n      fx: (this.crackX || W * 0.35) - W * 0.035,\n      fy: this.cliffY + H * 0.014\n    };\n  }\n\n  fxCanvas() {\n    const c = this.cv();\n    return c && c.parentNode ? c.parentNode.querySelector('canvas[data-fx=\"1\"]') : null;\n  }\n\n  fxSetup() {\n    const c = this.fxCanvas();\n    if (!c) return null;\n    const dpr = Math.min(window.devicePixelRatio || 1, 2);\n    const o = { x: 0, y: 0, w: this.W, h: this.H };\n    this._fxOff = o;\n    const w = Math.round(o.w * dpr), h = Math.round(o.h * dpr);\n    if (c.width !== w || c.height !== h) { c.width = w; c.height = h; }\n    const x = c.getContext(\"2d\");\n    x.setTransform(dpr, 0, 0, dpr, Math.round(o.x * dpr), Math.round(o.y * dpr));\n    return x;\n  }\n\n  fxClear(fx) {\n    const o = this._fxOff;\n    fx.clearRect(-o.x - 2, -o.y - 2, o.w + 4, o.h + 4);\n  }\n\n  withCtx(ctx, seed, fn) {\n    const oc = this.ctx, oR = this.R;\n    this.ctx = ctx;\n    this.R = this.rngFrom(seed >>> 0);\n    try { fn(); } finally { this.ctx = oc; this.R = oR; }\n  }\n\n  /* a sketched grand piano; broken = lid torn off and body split */\n  piano(cx, cy, pw, rot, o, broken) {\n    const ph = pw * 0.5;\n    const T = (p) => {\n      const x = p[0] * pw, y = p[1] * ph;\n      return [cx + x * Math.cos(rot) - y * Math.sin(rot), cy + x * Math.sin(rot) + y * Math.cos(rot)];\n    };\n    const poly = (arr, oo) => {\n      for (let i = 1; i < arr.length; i++) this.gLine(T(arr[i - 1]), T(arr[i]), oo || o);\n    };\n    poly([[-0.5, -0.16], [0.32, -0.16], [0.5, 0.0], [0.47, 0.2], [-0.5, 0.2], [-0.5, -0.16]]);\n    if (broken) {\n      poly([[-0.46, -0.2], [-0.05, -0.44], [0.16, -0.3]], { ...o, alpha: o.alpha * 0.85 });\n      poly([[0.2, -0.52], [0.62, -0.34], [0.5, -0.2]], { ...o, alpha: o.alpha * 0.7 });\n      poly([[-0.1, -0.16], [-0.02, 0.2]], { ...o, alpha: o.alpha * 0.6 });\n      poly([[0.14, -0.16], [0.24, 0.14]], { ...o, alpha: o.alpha * 0.5 });\n    } else {\n      poly([[-0.47, -0.18], [0.06, -0.6], [0.34, -0.47], [0.31, -0.17]]);\n    }\n    this.gLine(T([-0.5, 0.03]), T([-0.14, 0.03]), { ...o, alpha: o.alpha * 0.8 });\n    for (let i = 0; i < 7; i++) {\n      const t = -0.48 + i * 0.048;\n      this.gLine(T([t, 0.04]), T([t, 0.17]), { ...o, alpha: o.alpha * 0.4, width: o.width * 0.5 });\n    }\n    const legs = broken ? [[[-0.44, 0.2], [-0.62, 0.34]], [[0.3, 0.2], [0.36, 0.46]]] : [[[-0.44, 0.2], [-0.46, 0.46]], [[0.32, 0.2], [0.35, 0.47]], [[-0.04, 0.2], [-0.02, 0.42]]];\n    for (const l of legs) this.gLine(T(l[0]), T(l[1]), { ...o, alpha: o.alpha * 0.85 });\n  }\n\n  /* one-off sprite so the fall is a blit per frame, not a redraw */\n  bakePiano(pw) {\n    const dpr = Math.min(window.devicePixelRatio || 1, 2);\n    const w = pw * 1.9, h = pw * 1.7;\n    const ink = document.createElement(\"canvas\");\n    ink.width = Math.round(w * dpr); ink.height = Math.round(h * dpr);\n    const ix = ink.getContext(\"2d\");\n    ix.setTransform(dpr, 0, 0, dpr, (w / 2) * dpr, (h / 2) * dpr);\n    this.withCtx(ix, 4242, () => {\n      this.piano(0, 0, pw, 0, { alpha: 1, width: 2.1, wobble: 0.5, taper: 0.5, grain: 0.5, breakUp: 0.14, passes: 2 }, false);\n    });\n    const out = document.createElement(\"canvas\");\n    out.width = ink.width; out.height = ink.height;\n    const ox = out.getContext(\"2d\");\n    ox.globalCompositeOperation = \"lighter\";\n    if (this.night) {\n      ox.filter = \"blur(\" + (5 * this.u * dpr).toFixed(1) + \"px)\";\n      ox.globalAlpha = 0.5;\n      ox.drawImage(ink, 0, 0);\n      ox.filter = \"none\";\n    }\n    ox.globalAlpha = 1;\n    ox.drawImage(ink, 0, 0);\n    return { c: out, w: w, h: h };\n  }\n\n  /* impact: bury the figure in dust and stamp the wreck straight onto the scene */\n  stampCrush() {\n    const m = this.figMark, lc = this.cv();\n    if (!m || !lc) return;\n    const dpr = Math.min(window.devicePixelRatio || 1, 2);\n    const pw = Math.max(this.W * 0.15, m.hf * 1.3);\n    const lx = lc.getContext(\"2d\");\n    lx.save();\n    lx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    const R2 = this.rngFrom(5150);\n    for (let i = 0; i < 12; i++) {\n      const bxc = m.fx + (R2() - 0.5) * m.hf * 0.75;\n      const byc = m.fy - m.hf * (0.15 + R2() * 0.85);\n      const br = m.hf * (0.26 + R2() * 0.3);\n      const g = lx.createRadialGradient(bxc, byc, 0, bxc, byc, br);\n      g.addColorStop(0, this.paper);\n      g.addColorStop(0.6, this.night ? \"rgba(11,12,14,0.92)\" : \"rgba(240,237,228,0.92)\");\n      g.addColorStop(1, this.night ? \"rgba(11,12,14,0)\" : \"rgba(240,237,228,0)\");\n      lx.fillStyle = g;\n      lx.beginPath();\n      lx.arc(bxc, byc, br, 0, 6.2832);\n      lx.fill();\n    }\n    lx.restore();\n\n    const pad = m.hf * 0.5;\n    const bx = m.fx - pw, by = m.fy - m.hf * 1.15 - pad;\n    const bw = pw * 2, bh = m.hf * 1.3 + pad * 2;\n    const ink = document.createElement(\"canvas\");\n    ink.width = Math.max(1, Math.round(bw * dpr));\n    ink.height = Math.max(1, Math.round(bh * dpr));\n    const ix = ink.getContext(\"2d\");\n    ix.setTransform(dpr, 0, 0, dpr, -bx * dpr, -by * dpr);\n    this.withCtx(ix, 6060, () => {\n      this.wreck();\n      const ink2 = { alpha: 0.5, width: 1.2, wobble: 0.6, taper: 0.9, grain: 0.35 };\n      for (let i = 0; i < 16; i++) {\n        const a = this.r(-3.0, -0.2), Ls = pw * this.r(0.08, 0.34);\n        const sx = m.fx + this.g() * pw * 0.3, sy = m.fy + this.g() * pw * 0.04;\n        this.stroke([[sx, sy], [sx + Math.cos(a) * Ls, sy + Math.sin(a) * Ls]], ink2);\n      }\n    });\n    lx.save();\n    lx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    lx.globalCompositeOperation = \"lighter\";\n    if (this.night) {\n      lx.filter = \"blur(\" + (5 * this.u).toFixed(1) + \"px)\";\n      lx.globalAlpha = 0.5;\n      lx.drawImage(ink, bx, by, bw, bh);\n      lx.filter = \"none\";\n    }\n    lx.globalAlpha = 1;\n    lx.drawImage(ink, bx, by, bw, bh);\n    lx.restore();\n  }\n\n  wreck() {\n    const m = this.figMark;\n    if (!m) return;\n    const pw = Math.max(this.W * 0.15, m.hf * 1.3);\n    const ink = { alpha: this.night ? 1 : 0.85, width: this.night ? 2.2 : 1.3, wobble: 0.65, taper: 0.55, grain: 0.55, breakUp: 0.16, passes: 2 };\n    this.piano(m.fx + m.hf * 0.12, m.fy - pw * 0.14, pw, 0.1, ink, true);\n    for (let i = 0; i < 14; i++) {\n      const a = this.r(-2.9, -0.3), L = pw * this.r(0.06, 0.3);\n      const sx = m.fx + this.g() * pw * 0.4, sy = m.fy + this.g() * pw * 0.05;\n      this.gLine([sx, sy], [sx + Math.cos(a) * L, sy + Math.sin(a) * L], { ...ink, alpha: 0.5 * this.r(0.5, 1), width: 1.2, passes: 1 });\n    }\n  }\n\n  debris(impact, pw, p) {\n    const n = 22;\n    for (let i = 0; i < n; i++) {\n      const a = this.r(-3.0, -0.15), L = pw * this.r(0.15, 0.75) * (0.4 + p);\n      const x = impact.x + this.g() * pw * 0.2, y = impact.y + pw * 0.12;\n      this.stroke([[x, y], [x + Math.cos(a) * L, y + Math.sin(a) * L]], { alpha: (1 - p) * 0.9, width: this.r(1, 2.4), wobble: 0.5, taper: 0.9, grain: 0.3 });\n    }\n  }\n\n  /* the presence: an original face, anchored so the two glows are its eyes */\n  buildFace() {\n    const M = this.faceMetrics();\n    if (!M) return null;\n    const dpr = Math.min(window.devicePixelRatio || 1, 2);\n    const pad = M.minD * 0.18;\n    const bx = M.cx - M.hw - pad, by = M.top - pad;\n    const bw = M.hw * 2 + pad * 2, bh = M.fh + pad * 2;\n    const ink = document.createElement(\"canvas\");\n    ink.width = Math.max(1, Math.round(bw * dpr));\n    ink.height = Math.max(1, Math.round(bh * dpr));\n    const ix = ink.getContext(\"2d\");\n    ix.setTransform(dpr, 0, 0, dpr, -bx * dpr, -by * dpr);\n    this.withCtx(ix, 7717, () => this.faceArt());\n    const out = document.createElement(\"canvas\");\n    out.width = ink.width; out.height = ink.height;\n    const ox = out.getContext(\"2d\");\n    ox.globalCompositeOperation = \"lighter\";\n    if (this.night) {\n      ox.filter = \"blur(\" + (6 * this.u * dpr).toFixed(1) + \"px)\";\n      ox.globalAlpha = 0.55;\n      ox.drawImage(ink, 0, 0);\n      ox.filter = \"none\";\n    }\n    ox.globalAlpha = 1;\n    ox.drawImage(ink, 0, 0);\n    const fy0 = (this.H * 0.95 - by) * dpr, fy1 = (this.H * 1.06 - by) * dpr;\n    if (fy0 < out.height) {\n      const g = ox.createLinearGradient(0, fy0, 0, fy1);\n      g.addColorStop(0, \"rgba(0,0,0,0)\");\n      g.addColorStop(1, \"rgba(0,0,0,1)\");\n      ox.globalCompositeOperation = \"destination-out\";\n      ox.fillStyle = g;\n      ox.fillRect(0, fy0, out.width, out.height - fy0);\n    }\n    this._faceBox = { x: bx, y: by, w: bw, h: bh };\n    return out;\n  }\n\n  faceMetrics() {\n    const e = this.eyeSpots;\n    if (!e || e.length < 2) return null;\n    const L = e[0].x <= e[1].x ? e[0] : e[1], Rr = e[0].x <= e[1].x ? e[1] : e[0];\n    const cx = (L.x + Rr.x) / 2, my = (L.y + Rr.y) / 2;\n    const span = Math.max(24, Rr.x - L.x);\n    const minD = Math.min(this.W, this.H);\n    const hw = Math.min(span * 1.32, this.W * 0.985 - cx, cx - this.W * 0.015, minD * 0.46);\n    const fh = hw * 2.05;\n    return { L: L, Rr: Rr, cx: cx, my: my, span: span, minD: minD, hw: hw, fh: fh, top: my - fh * 0.5 };\n  }\n\n  faceArt() {\n    const M = this.faceMetrics();\n    if (!M) return;\n    const L = M.L, Rr = M.Rr, cx = M.cx, my = M.my, span = M.span, minD = M.minD, hw = M.hw, fh = M.fh, top = M.top;\n    const Y = (f) => top + fh * f;\n    const ink = { alpha: 0.5, width: 1.5, wobble: 0.6, taper: 0.7, grain: 0.5, breakUp: 0.26 };\n    const hard = { alpha: 0.58, width: 1.7, wobble: 0.5, taper: 0.6, grain: 0.5, breakUp: 0.16, passes: 2 };\n\n    /* skull: broad temple, hollow cheek, tapering chin */\n    const side = (sg) => this.spline([\n      [cx + sg * hw * 0.44, Y(0.016)],\n      [cx + sg * hw * 0.8, Y(0.12)],\n      [cx + sg * hw * 0.96, Y(0.3)],\n      [cx + sg * hw, Y(0.5)],\n      [cx + sg * hw * 0.85, Y(0.72)],\n      [cx + sg * hw * 0.6, Y(0.88)],\n      [cx + sg * hw * 0.3, Y(1)]\n    ], 16);\n    this.stroke(side(-1), ink);\n    this.stroke(side(1), ink);\n    this.stroke(this.spline([[cx - hw * 0.44, Y(0.016)], [cx - hw * 0.18, Y(-0.022)], [cx + hw * 0.18, Y(-0.022)], [cx + hw * 0.44, Y(0.016)]], 12), { ...ink, alpha: 0.42 });\n    this.stroke(this.spline([[cx - hw * 0.3, Y(1)], [cx, Y(1.016)], [cx + hw * 0.3, Y(1)]], 8), { ...ink, alpha: 0.34 });\n    this.gLine([cx - hw * 0.5, Y(1.02)], [cx - hw * 0.62, Y(1.16)], { ...ink, alpha: 0.22, width: 1.2 });\n    this.gLine([cx + hw * 0.5, Y(1.02)], [cx + hw * 0.62, Y(1.16)], { ...ink, alpha: 0.22, width: 1.2 });\n\n    /* brow ridge over both eyes */\n    this.stroke(this.spline([\n      [cx - hw * 0.9, my - span * 1.02],\n      [L.x - span * 0.1, my - span * 0.78],\n      [cx, my - span * 0.46],\n      [Rr.x + span * 0.1, my - span * 0.78],\n      [cx + hw * 0.9, my - span * 1.02]\n    ], 16), hard);\n\n    /* angular sockets around each glow, hollow beneath */\n    for (const q of [L, Rr]) {\n      const wo = q.r * 1.9, wi = q.r * 1.15, h = q.r * 1.0, w = wo;\n      const sg = q === L ? -1 : 1;\n      this.stroke(this.spline([\n        [q.x + sg * wo, q.y - h * 0.34],\n        [q.x + sg * wo * 0.3, q.y - h * 1.05],\n        [q.x - sg * wi * 0.55, q.y - h * 0.62],\n        [q.x - sg * wi, q.y + h * 0.12],\n        [q.x - sg * wi * 0.4, q.y + h * 0.95],\n        [q.x + sg * wo * 0.5, q.y + h * 0.72],\n        [q.x + sg * wo, q.y - h * 0.34]\n      ], 14), { ...ink, alpha: 0.5, width: 1.5 });\n      this.hatchBox(q.x - w, q.y + h * 0.95, q.x + w * 0.8, q.y + h * 2.6, {\n        angle: -1.15 + sg * 0.25, count: 30, len: q.r * 0.85, alpha: 0.15, width: 1\n      });\n    }\n\n    /* nose: a narrow wedge, barely there */\n    this.stroke(this.spline([[cx + span * 0.03, my - span * 0.18], [cx + span * 0.1, my + span * 0.5], [cx - span * 0.02, my + span * 0.88]], 10), { ...ink, alpha: 0.32, width: 1.2 });\n    this.gLine([cx - span * 0.17, my + span * 0.9], [cx + span * 0.19, my + span * 0.92], { ...ink, alpha: 0.28, width: 1.1 });\n\n    /* mouth: long seam with ticks */\n    const mo = my + fh * 0.24;\n    this.stroke(this.spline([\n      [cx - hw * 0.5, mo + span * 0.08],\n      [cx - hw * 0.16, mo - span * 0.02],\n      [cx + hw * 0.18, mo - span * 0.01],\n      [cx + hw * 0.5, mo + span * 0.1]\n    ], 14), { ...ink, alpha: 0.44, width: 1.5 });\n    for (let i = 0; i < 5; i++) {\n      const x0 = cx + hw * (-0.34 + i * 0.17);\n      this.gLine([x0, mo - span * 0.04], [x0 + this.g() * span * 0.03, mo + span * 0.1], { ...ink, alpha: 0.14, width: 0.8 });\n    }\n\n    /* cheek hollows */\n    this.hatchBox(cx - hw * 0.96, my + fh * 0.05, cx - hw * 0.44, my + fh * 0.3, { angle: -1.25, count: 44, len: fh * 0.05, alpha: 0.12, width: 1 });\n    this.hatchBox(cx + hw * 0.44, my + fh * 0.05, cx + hw * 0.96, my + fh * 0.3, { angle: -1.25, count: 44, len: fh * 0.05, alpha: 0.12, width: 1 });\n\n    /* fractures, same vocabulary as the rock */\n    for (let i = 0; i < 3; i++) {\n      let px = cx + this.g() * hw * 0.7, py = Y(this.r(0.08, 0.85));\n      for (let k = 0; k < 3; k++) {\n        const a = this.r(-2.6, -0.6), Ls = fh * this.r(0.05, 0.16);\n        const nx2 = px + Math.cos(a) * Ls, ny2 = py + Math.sin(a) * Ls;\n        this.gLine([px, py], [nx2, ny2], { ...ink, alpha: 0.2, width: 1 });\n        px = nx2; py = ny2;\n      }\n    }\n\n    /* aura */\n    for (let i = 0; i < 24; i++) {\n      const a = this.r(0, 6.283);\n      const sx = cx + Math.cos(a) * hw * this.r(1.06, 1.34);\n      const sy = my + fh * 0.06 + Math.sin(a) * fh * 0.5 * this.r(1.04, 1.3);\n      const Ls = minD * this.r(0.03, 0.12);\n      this.stroke([[sx, sy], [sx + Math.cos(a) * Ls, sy + Math.sin(a) * Ls]], { alpha: 0.15, width: 1.1, wobble: 0.6, taper: 1, grain: 0.3 });\n    }\n  }\n\n  revealFace(fx, p) {\n    if (!fx) return;\n    if (this._face === undefined || this._face === null) this._face = this.buildFace();\n    const M = this.faceMetrics();\n    if (!M || !this._face) return;\n    const ease = 1 - Math.pow(1 - p, 3);\n    const R = Math.max(this.W, this.H) * 1.4 * ease;\n    const o = this._fxOff;\n    this.fxClear(fx);\n    fx.save();\n    fx.fillStyle = \"rgba(6,8,12,\" + (0.5 * ease).toFixed(3) + \")\";\n    fx.fillRect(-o.x, -o.y, o.w, o.h);\n    fx.restore();\n    fx.save();\n    fx.beginPath();\n    fx.arc(M.cx, M.my, R, 0, 6.2832);\n    fx.clip();\n    fx.globalCompositeOperation = \"lighter\";\n    fx.globalAlpha = Math.min(1, p * 1.4);\n    const b = this._faceBox;\n    fx.drawImage(this._face, b.x, b.y, b.w, b.h);\n    fx.restore();\n  }\n\n  startCalamity() {\n    if (this._raf || this.state.phase) return;\n    const m = this.figMark;\n    if (!m) return;\n    const root = this.cv().parentNode;\n    const impact = { x: m.fx + m.hf * 0.12, y: m.fy - m.hf * 0.92 };\n    const pw = Math.max(this.W * 0.15, m.hf * 1.3);\n    const D = { fall: 820, hit: 300, reveal: 1600 };\n    this._crushed = false;\n    this._face = null;\n    this.setState({ phase: 1 });\n    this._pianoSprite = this.bakePiano(pw);\n    const t0 = performance.now();\n    const step = () => {\n      const t = performance.now() - t0;\n      const fx = this.fxSetup();\n      if (!fx) { this._raf = 0; return; }\n      if (t < D.fall) {\n        const p = t / D.fall, e = p * p;\n        const y = -this.H * 0.3 + (impact.y + this.H * 0.3) * e;\n        this.fxClear(fx);\n        const sp = this._pianoSprite;\n        if (sp) {\n          fx.save();\n          fx.globalCompositeOperation = \"lighter\";\n          fx.strokeStyle = \"rgba(\" + this.inkRGB + \",0.24)\";\n          fx.lineWidth = 1.1;\n          fx.beginPath();\n          for (let i = 0; i < 6; i++) {\n            const sx = impact.x + (i / 5 - 0.5) * pw * 0.9;\n            const len = pw * (0.35 + 0.5 * ((i * 37) % 7) / 7) * (0.3 + p);\n            fx.moveTo(sx, y - pw * 0.55 - len);\n            fx.lineTo(sx, y - pw * 0.5);\n          }\n          fx.stroke();\n          fx.translate(impact.x, y);\n          fx.rotate(-0.32 + 0.4 * e);\n          fx.drawImage(sp.c, -sp.w / 2, -sp.h / 2, sp.w, sp.h);\n          fx.restore();\n        }\n      } else if (t < D.fall + D.hit) {\n        const p = (t - D.fall) / D.hit;\n        if (!this._crushed) {\n          this._crushed = true;\n          this._phase = 1;\n          this.stampCrush();\n        }\n        this.fxClear(fx);\n        fx.save();\n        fx.globalCompositeOperation = \"lighter\";\n        fx.fillStyle = \"rgba(200,224,255,\" + (0.55 * Math.pow(1 - p, 1.6)).toFixed(3) + \")\";\n        fx.fillRect(0, 0, this.W, this.H);\n        fx.restore();\n        this.withCtx(fx, 9100 + Math.floor(p * 4), () => this.debris(impact, pw, p));\n        if (root) {\n          const k = (1 - p) * 9;\n          root.style.transform = \"translate(\" + (Math.sin(p * 46) * k).toFixed(2) + \"px,\" + (Math.cos(p * 37) * k * 0.7).toFixed(2) + \"px) scale(\" + (1 + 0.004 * k).toFixed(4) + \")\";\n        }\n      } else {\n        if (root) root.style.transform = \"none\";\n        const p = Math.min(1, (t - D.fall - D.hit) / D.reveal);\n        this.revealFace(fx, p);\n      }\n      if (t < D.fall + D.hit + D.reveal) this._raf = requestAnimationFrame(step);\n      else { this._raf = 0; this.revealFace(this.fxSetup(), 1); }\n    };\n    this._raf = requestAnimationFrame(step);\n  }\n\n  resetCalamity() {\n    if (this._raf) cancelAnimationFrame(this._raf);\n    this._raf = 0;\n    this._crushed = false;\n    this._phase = 0;\n    this._face = null;\n    this._pianoSprite = null;\n    const fx = this.fxSetup();\n    if (fx) this.fxClear(fx);\n    const root = this.cv() && this.cv().parentNode;\n    if (root) {\n      root.style.transform = \"none\";\n      root.style.transformOrigin = \"\";\n      const fxc = this.fxCanvas();\n      if (fxc) { fxc.style.transform = \"none\"; fxc.style.transformOrigin = \"\"; }\n      const socks = root.querySelectorAll(\"[data-eye-socket]\");\n      for (const sk of socks) { sk.style.transform = \"none\"; sk.style.transformOrigin = \"\"; }\n    }\n    this.setState({ phase: 0 });\n    this._painted = false;\n    this.paint();\n  }\n\n  /* ---------- paper tooth over everything ---------- */\n  grainPass(target) {\n    const G = this.props.grain == null ? 1 : this.props.grain;\n    if (G <= 0.001) return;\n    const c = target || this.cv(), ctx = this.vctx;\n    const cw = c.width, ch = c.height;\n    if (!cw || !ch) return;\n    if (!this._tile) {\n      let s = 1234567;\n      const rnd = () => { s = (s * 1664525 + 1013904223) >>> 0; return s / 4294967296; };\n      const T = new Float32Array(256 * 256);\n      for (let i = 0; i < T.length; i++) T[i] = rnd();\n      /* soften slightly so it reads as tooth, not TV static */\n      const S = new Float32Array(256 * 256);\n      for (let y = 0; y < 256; y++) {\n        for (let x = 0; x < 256; x++) {\n          const i = y * 256 + x;\n          S[i] = (T[i] * 2 + T[(y * 256) + ((x + 1) & 255)] + T[(((y + 1) & 255) * 256) + x]) / 4;\n        }\n      }\n      this._tile = S;\n    }\n    const T = this._tile;\n    const img = ctx.getImageData(0, 0, cw, ch);\n    const d = img.data;\n    const night = this.night;\n    const PR = night ? 11 : 240, PG = night ? 12 : 237, PB = night ? 14 : 228;\n    const vx = new Float32Array(cw);\n    for (let x = 0; x < cw; x++) { const t = x / cw - 0.5; vx[x] = t * t; }\n    for (let y = 0; y < ch; y++) {\n      const ty = y / ch - 0.5;\n      const vyv = ty * ty;\n      const row = (y & 255) << 8;\n      for (let x = 0; x < cw; x++) {\n        const i = (y * cw + x) << 2;\n        const n = T[row | (x & 255)];\n        const light = Math.max(0, n - 0.56) * 1.7 * G;\n        const dark = Math.max(0, 0.42 - n) * 0.2 * G;\n        let vig = 1 - (vx[x] + vyv) * (night ? 0.36 : 0.19);\n        if (night) vig *= 1 - Math.max(0, (y / ch - 0.74) / 0.26) * 0.3;\n        let r = d[i], g = d[i + 1], b = d[i + 2];\n        r += (PR - r) * light; g += (PG - g) * light; b += (PB - b) * light;\n        r = r * (1 - dark) * vig; g = g * (1 - dark) * vig; b = b * (1 - dark) * vig;\n        if (night) { const f = (n - 0.5) * 8 * G; r += f; g += f; b += f * 1.12; }\n        d[i] = r; d[i + 1] = g; d[i + 2] = b;\n      }\n    }\n    ctx.putImageData(img, 0, 0);\n  }\n\n  /* ---------- main ---------- */\n  paint(target) {\n    const live = this.cv();\n    if (!live) return;\n    const c = target || live;\n    const host = live.parentNode && live.parentNode.parentNode;\n    const rect = host ? { width: host.offsetWidth, height: host.offsetHeight } : live.getBoundingClientRect();\n    const W = Math.max(240, Math.round(rect.width));\n    const H = Math.max(240, Math.round(rect.height));\n    if (!target && this._lastW && Math.abs(W - this._lastW) < this._lastW * 0.02 && Math.abs(H - this._lastH) < this._lastH * 0.06 && this._painted) return;\n    if (!target) { this._lastW = W; this._lastH = H; this._painted = true; }\n    const dpr = Math.min(window.devicePixelRatio || 1, 2);\n    c.width = Math.round(W * dpr);\n    c.height = Math.round(H * dpr);\n    const ctx = c.getContext(\"2d\");\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    this.vctx = ctx;\n    const off = document.createElement(\"canvas\");\n    off.width = c.width; off.height = c.height;\n    const octx = off.getContext(\"2d\");\n    octx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    this.ctx = octx;\n    this.W = W; this.H = H;\n    this.night = (this.props.mode || \"night\") !== \"paper\";\n    this.paper = this.night ? \"#0b0c0e\" : \"#f0ede4\";\n    this.inkRGB = this.night ? \"226,235,244\" : \"41,38,34\";\n    this.hatchInk = this.night ? 0.1 : 1;\n    this.deepInk = this.night ? 0.4 : 1;\n    if (c.parentNode && c.parentNode.style) c.parentNode.style.background = this.paper;\n    document.documentElement.style.background = this.paper;\n    document.body.style.background = this.paper;\n    this.u = Math.max(0.85, Math.min(W, H) / 560);\n    this.ink = this.props.inkStrength == null ? 1 : this.props.inkStrength;\n    this.R = this.rngFrom((this.props.seed == null ? 4211 : this.props.seed) | 0);\n    this.clear = [];\n    this.eyeSpots = [];\n\n    /* composition bands adapt from tall-portrait to wide-landscape */\n    const t = Math.max(0, Math.min(1, (W / H - 0.5) / 1.3));\n    const lerp = (a, b) => a + (b - a) * t;\n    this.mesaTop = H * lerp(0.43, 0.31);\n    this.horizon = H * lerp(0.655, 0.6);\n    this.cliffY = H * lerp(0.748, 0.7);\n    this.skyBottom = this.mesaTop * 0.8;\n\n    this.background();\n    this.sky();\n    octx.save();\n    octx.globalCompositeOperation = \"destination-out\";\n    octx.fillStyle = \"#000\";\n    octx.fillRect(-2, this.skyBottom, W + 4, H - this.skyBottom + 4);\n    octx.restore();\n    this.distantRidge();\n    this.mesas();\n    this.terraces();\n    this.foreground();\n    this.figMark = this.figSpot();\n    if (!this._phase) this.figure(); else this.wreck();\n\n    ctx.save();\n    ctx.setTransform(1, 0, 0, 1, 0, 0);\n    if (this.night) {\n      const glow = this.props.glow == null ? 1 : this.props.glow;\n      ctx.globalCompositeOperation = \"lighter\";\n      ctx.filter = \"blur(\" + (8 * this.u * dpr).toFixed(1) + \"px)\";\n      ctx.globalAlpha = 0.34 * glow;\n      ctx.drawImage(off, 0, 0);\n      ctx.filter = \"blur(\" + (2.4 * this.u * dpr).toFixed(1) + \"px)\";\n      ctx.globalAlpha = 0.42 * glow;\n      ctx.drawImage(off, 0, 0);\n      ctx.filter = \"none\";\n      ctx.globalCompositeOperation = \"source-over\";\n    }\n    ctx.globalAlpha = 1;\n    ctx.drawImage(off, 0, 0);\n    ctx.restore();\n    this.grainPass(c);\n    if (target) return;\n    const spots = this.night ? this.eyeSpots : [];\n    const m = this.figMark;\n    this.setState({\n      eyes: spots.map((e) => ({ x: e.x, y: e.y, r: e.r })),\n      figBox: m ? { x: m.fx - m.hf * 0.22, y: m.fy - m.hf * 1.04, w: m.hf * 0.52, h: m.hf * 1.1 } : null\n    });\n  }\n\n  /* cursor parallax: the iris outruns the halo, as in the reference sketch */\n  aimEyes(fx, fy) {\n    const root = this.cv() && this.cv().parentNode;\n    if (!root) return;\n    const set = (sel, range) => {\n      const edge = (100 - range) / 2;\n      const els = root.querySelectorAll(sel);\n      for (const el of els) {\n        el.style.left = edge + fx * range + \"%\";\n        el.style.top = edge + fy * range + \"%\";\n      }\n    };\n    set(\"[data-eye-glow]\", 35);\n    set(\"[data-eye-iris]\", 65);\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>